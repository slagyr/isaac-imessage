{:id      :isaac.comm.imessage
 :version "0.1.6"
 :factory isaac.module.protocol/module

 :isaac.agent/comm
 {:imessage {:namespace    isaac.comm.imessage
             :extra-schema {:imessage/service     {:type        :string
                                                   :description "Transport imsg should use: \"auto\" (imsg picks — the working value, and what Isaac does when this key is omitted), \"sms\", or \"imessage\". Omit it unless you mean to pin the transport. Do not set \"imessage\": through imsg's AppleScript transport an explicit imessage send reports -32001 \"Delivery outcome unknown\" and never arrives (measured 2026-09-24 against a live iMessage chat); \"auto\" delivers on the first attempt."}
                            :imessage/db-path     {:type        :string
                                                   :description "Absolute path to Messages chat.db (typically /Users/<you>/Library/Messages/chat.db). Required to spawn the imsg subprocess; omitting it leaves the comm off so tests don't accidentally hit a real chat.db."}
                            :imessage/bin         {:type        :string
                                                   :description "Path to the imsg binary (e.g. /usr/local/bin/imsg). Defaults to whatever is on PATH; set explicitly when the running shell PATH doesn't include /usr/local/bin (common for headless processes). Ignored when :imessage/command is set."}
                            :imessage/command     {:type        :seq
                                                   :spec        {:type :string}
                                                   :description "Full argv prefix before imsg rpc/--db (e.g. [\"ssh\" \"-T\" \"user@mac\" \"/usr/local/bin/imsg\"]). Use for stdio wrappers that tunnel JSON-RPC to a remote Mac; takes precedence over :imessage/bin."}
                            :imessage/message-cap {:type        :int
                                                   :description "Chunk reply text into separate sends above this character count. Defaults to 2000."}
                            :imessage/max-chunks  {:type        :int
                                                   :description "Hard cap on chunks a single reply produces. Above the cap the tail is dropped with a notice. Defaults to 3 — long replies become 3 messages, not 50."}
                            :imessage/allow-from  {:type        :seq
                                                   :spec        {:type :string}
                                                   :description "Inbound allowlist of iMessage handles (phone numbers or emails). nil/missing = no filter; empty list = fail-closed (drops everything)."}}
             :send-schema  {:imessage/target  {:type        :string
                                                :description "Recipient handle (phone number or email) for the outbound message."}
                            :imessage/service {:type        :string
                                               :validations [[:one-of? "auto" "sms" "imessage"]]
                                               :description "Transport for this one message: \"auto\" (imsg picks), \"sms\", or \"imessage\" (known to fail through imsg's AppleScript transport — prefer auto). Falls back to the comm slice's :imessage/service; with neither set, no service is sent and imsg chooses."}}}}}