{:id      :isaac.comm.imessage
 :version "0.1.0"
 :comm    {:imessage {:factory isaac.comm.imessage/make
                      :schema  {:service          {:type :string}
                                :default-target   {:type :string}
                                :poll-interval-ms {:type        :int
                                                   :description "Polling cadence in milliseconds. Required (with :db-path) to start the inbound poller."}
                                :db-path          {:type        :string
                                                   :description "Absolute path to Messages chat.db (typically /Users/<you>/Library/Messages/chat.db). Required to start the inbound poller; omitting it leaves the poller off so tests don't accidentally read a real chat.db."}
                                :message-cap      {:type        :int
                                                   :description "Chunk reply text into separate sends above this character count. Defaults to 2000."}
                                :allow-from       {:type        :seq
                                                   :spec        {:type :string}
                                                   :description "Inbound allowlist of iMessage handles (phone numbers or emails). nil/missing = no filter; empty list = fail-closed (drops everything)."}}}}}
