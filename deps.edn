{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.slagyr/isaac {:git/url "https://github.com/slagyr/isaac.git"
                                :git/sha "3f2364fb4940412f29b8abc5577ce74d5c20776a"}}

 :aliases
 {:dev-local {:override-deps {io.github.slagyr/isaac {:local/root "../isaac/isaac-worker-2"}}}

  :test {:extra-paths ["spec"]
         :extra-deps  {speclj/speclj {:mvn/version "3.13.0"}}}

  :spec {:extra-paths ["spec"]
         :extra-deps  {speclj/speclj {:mvn/version "3.13.0"}}
         :main-opts   ["-m" "speclj.main" "-c" "-D" "spec"]}}}
