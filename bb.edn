{:paths ["src" "spec"]

 :deps {io.github.slagyr/isaac-foundation-test-support {:git/url "https://github.com/slagyr/isaac-foundation.git"
                                                        :git/sha "44e824c6eded90301ed1aba8ed3948c66725ee43"
                                                        :deps/root "spec-support"}}

 :tasks
 {config-bypass-lint {:doc "Fail on raw config slurp/read outside isaac.config.* (isaac-foundation-test-support)"
                      :requires ([isaac.foundation.config-bypass-lint :as lint])
                      :task (apply lint/lint! (or (seq *command-line-args*) ["src"]))}

  spec {:doc  "Run speclj specs (pass file/dir to narrow)"
        :task (if (seq *command-line-args*)
                (apply shell "clojure" "-M:spec" *command-line-args*)
                (shell "clojure" "-M:spec"))}

  ci {:doc  "Run unit specs + acceptance features"
      :task (do (run 'config-bypass-lint)
                (shell "clojure" "-M:spec")
                (shell "clojure" "-M:features"))}

  features {:doc  "Run gherclj feature specs (excludes @wip)"
            :task (do
                    (babashka.fs/delete-tree "target")
                    (apply shell "clojure" "-M:features" *command-line-args*))}

  smoke {:doc      "Sanity-check the local Mac for iMessage usage. Verifies osascript / sqlite3 are on PATH and tries a read of ~/Library/Messages/chat.db. Optional: pass a handle + message to actually send a test iMessage. Usage: bb smoke [<handle> <message>]"
         :requires ([babashka.fs :as fs]
                    [babashka.process :as p]
                    [clojure.string :as str])
         :task     (let [home       (System/getProperty "user.home")
                         chat-db    (str home "/Library/Messages/chat.db")
                         [handle & body-parts] *command-line-args*
                         body       (when (seq body-parts) (str/join " " body-parts))
                         check      (fn [label cmd]
                                      (println "▸" label)
                                      (try
                                        (let [{:keys [exit out err]} (deref (p/process cmd {:out :string :err :string}))]
                                          (if (zero? exit)
                                            (println "  ✓ " (str/trim (or out "")))
                                            (println "  ✗ exit=" exit "err=" (str/trim (or err "")))))
                                        (catch Exception e
                                          (println "  ✗" (.getMessage e)))))]
                     (check "osascript on PATH" ["osascript" "-e" "return \"ok\""])
                     (check "sqlite3 on PATH" ["sqlite3" "-version"])
                     (println "▸ chat.db readable (requires Full Disk Access)")
                     (if-not (fs/exists? chat-db)
                       (println "  ✗ not found at" chat-db)
                       (check "chat.db count" ["sqlite3" chat-db "SELECT COUNT(*) FROM message;"]))
                     (if (and handle body)
                       (do
                         (println "▸ sending iMessage to" handle "(requires Automation permission for Messages)")
                         (check "send" ["osascript" "-e"
                                        (str "tell application \"Messages\"\n"
                                             "  set targetService to 1st service whose service type = iMessage\n"
                                             "  set targetBuddy to buddy \"" handle "\" of targetService\n"
                                             "  send \"" (str/replace body "\"" "\\\"") "\" to targetBuddy\n"
                                             "end tell")]))
                       (println "▸ skipping send (pass <handle> <message> args to exercise it)")))}}}